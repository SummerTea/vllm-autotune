# SSH transport options used by run.sh / probe.py.
# The hosts themselves are declared in target.yaml (single source of truth).
# Copy this file to .env and adjust.

# SSH port (default 22)
SSH_PORT=22

# Path to a private key, leave empty to use the default ssh agent/config
SSH_KEY=

# Remote directory where run.sh rsyncs the harness and runs experiments
REMOTE_DIR=~/vllm-autotune

# vLLM 端口单一来源：harness.yaml 的 remote.vllm_port（此处不重复定义）
